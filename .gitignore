# Copied in at build time by the pages workflow; never committed. Committing
# one would create a second copy of a source of truth that nothing checks:
# build_compat.py only compares compat.json against docs/compatibility.md, so a
# stale site/compat.json would drift silently.
site/catalog.json
site/compat.json
site/patterns.json
site/taxonomy.json
# Rendered at deploy by scripts/render_images.py, from the data above.
site/stats.json
site/img/
site/.nojekyll

__pycache__/
*.py[cod]
.venv/
venv/
.env
.DS_Store
.idea/
.vscode/
.claude/
